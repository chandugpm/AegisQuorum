# Do not use these example values. Generate two separate random secrets of 32+ characters.
DASHBOARD_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Optional: separate operator token; operators cannot run the destructive demo
DASHBOARD_OPERATOR_TOKEN=replace-with-a-long-random-operator-token
NODE_SERVICE_TOKEN=replace-with-a-different-long-random-service-token
# Optional policy and operational controls
POLICY_QUORUM=2
REQUEST_MAX_AGE_MS=30000
# Optional Meta Model API access; keep the real key in a secret manager.
MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
# Optional Baseten Open-Weights inference; keep the real key in a secret manager.
BASETEN_API_KEY=